void loop() {
  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("WiFi disconnected. Reconnecting...");
    connectWiFi();
  }

  if (WiFi.status() == WL_CONNECTED) {
    WiFiClientSecure client;
    client.setInsecure();

    HTTPClient http;

    Serial.println();
    Serial.println("Requesting weather...");

    if (!http.begin(client, weatherUrl)) {
      Serial.println("HTTP begin failed");
      delay(30000);
      return;
    }

    int httpCode = http.GET();

    Serial.print("HTTP code: ");
    Serial.println(httpCode);

    if (httpCode == HTTP_CODE_OK) {
      String payload = http.getString();

      JsonDocument doc;
      DeserializationError error = deserializeJson(doc, payload);

      if (error) {
        Serial.print("JSON parse failed: ");
        Serial.println(error.c_str());
      } else {
        const char* time = doc["current"]["time"] | "no time";
        float temperature = doc["current"]["temperature_2m"] | -999.0;
        int humidity = doc["current"]["relative_humidity_2m"] | -1;
        float windSpeed = doc["current"]["wind_speed_10m"] | -999.0;
        int weatherCode = doc["current"]["weather_code"] | -1;

        Serial.println("Weather data:");
        Serial.print("Time: ");
        Serial.println(time);

        Serial.print("Temperature: ");
        Serial.print(temperature, 1);
        Serial.println(" C");

        Serial.print("Humidity: ");
        Serial.print(humidity);
        Serial.println(" %");

        Serial.print("Wind speed: ");
        Serial.print(windSpeed, 1);
        Serial.println(" km/h");

        Serial.print("Weather code: ");
        Serial.println(weatherCode);

        Serial.println("Sending to STM32...");
        sendToSTM32(time, temperature, humidity, windSpeed, weatherCode);
        Serial.println("Sent");
      }
    } else {
      Serial.print("HTTP failed: ");
      Serial.println(http.errorToString(httpCode));
    }

    http.end();
  }

  delay(60000);
}